        <mxCell id="user" value="&lt;div style=&#x27;font-weight:bold;text-align:center;padding:6px 4px;border-bottom:1px solid #C026D3&#x27;&gt;User 用户表&lt;/div&gt;&lt;div style=&#x27;padding:6px 8px;text-align:left;line-height:1.6;border-bottom:1px solid #C026D3&#x27;&gt;username&amp;lt;br&amp;gt;nickname&amp;lt;br&amp;gt;role&amp;lt;br&amp;gt;status&lt;/div&gt;&lt;div style=&#x27;padding:6px 8px;text-align:left;line-height:1.6&#x27;&gt;+user_id (PK)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#C026D3;strokeWidth=2;align=center;verticalAlign=top;fontSize=12;fontColor=#1F2937;dashed=1;" vertex="1" parent="1">
