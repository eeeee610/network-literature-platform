<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novel.platform.modules.novel.mapper.TagMapper">

    <select id="selectActiveTags" resultType="com.novel.platform.modules.novel.dto.TagRow">
        SELECT tag_id, tag_name
        FROM tag
        WHERE is_active = 1
        ORDER BY tag_id ASC
    </select>

    <select id="countActiveTagsByIds" resultType="long">
        SELECT COUNT(*)
        FROM tag
        WHERE is_active = 1
          AND tag_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
